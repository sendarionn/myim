#!/bin/zsh

set -eu

bundle_identifier="io.github.sendarionn.inputmethod.myime"

plist_bundle_identifier() {
    /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
        "$1/Contents/Info.plist" 2>/dev/null || true
}

stop_process() {
    local process_name=$1
    local attempt
    /usr/bin/pkill -x "$process_name" 2>/dev/null || true
    for attempt in {1..50}; do
        if ! /usr/bin/pgrep -x "$process_name" >/dev/null 2>&1; then
            return 0
        fi
        /bin/sleep 0.1
    done
    echo "$process_name を終了できませんでした" >&2
    return 1
}

for user_application in /Users/*/Library/Input\ Methods/myim.app; do
    [[ -d "$user_application" ]] || continue
    if [[ "$(plist_bundle_identifier "$user_application")" == "$bundle_identifier" ]]; then
        echo "ユーザー領域のmyimと競合するためPKGをインストールできません" >&2
        echo "競合先: $user_application" >&2
        exit 1
    fi
done

stop_process myim
stop_process my-ime
stop_process myim-external-browser
stop_process myim-extension-host
stop_process myim-selection-service

exit 0
